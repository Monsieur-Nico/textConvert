{
  "compilerOptions": {
    // Node >= 22 (engines.node) runs ES2023 natively; ES2023 includes the
    // ES2022.Intl types for `Intl.Segmenter`.
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    // TypeScript 6 defaults this to []; src/cli.ts needs Node's globals and
    // `node:` modules.
    "types": ["node"],
    "resolveJsonModule": true,

    "declaration": true,
    // Rollup's TypeScript compilation produces the JS bundle; tsc only writes
    // the .d.ts tree. Without this, tsc's per-file JS output would sit next to
    // Rollup's bundled dist/textConvert.mjs.
    "emitDeclarationOnly": true,
    "outDir": "./dist",

    // JSR publishes src/ as-is and Deno/JSR transpile each file on its own
    // (#465): flags code, such as re-exporting a type without `type`, that
    // only works in a whole-program build.
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
